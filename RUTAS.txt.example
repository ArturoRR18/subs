# Rutas de ESTA maquina (copia como RUTAS.txt o corre: py validar_rutas.py)
# Formato CLAVE=valor, una por linea. RUTAS.txt NO se sube a git.

# Carpeta donde dejas los videos y subtitulos a revisar
CARPETA_ENTRADA=C:\Users\<TU_USUARIO>\Desktop\pelis

# ffprobe.exe (de FFmpeg). Deja vacio si ffprobe ya esta en el PATH.
FFPROBE=C:\ffmpeg\bin\ffprobe.exe

# Cuenta de OpenSubtitles.com (opcional, para --descargar). Escribela tu, no la compartas.
OPENSUBTITLES_USUARIO=
OPENSUBTITLES_CLAVE=

# Jellyfin (para verificar_jellyfin.py). Clave: Panel de control > Claves de API.
JELLYFIN_URL=http://<IP-DEL-NAS>:<PUERTO>
JELLYFIN_API_KEY=

# Carpeta de red que Jellyfin usa como biblioteca de peliculas (para ordenar_biblioteca.py)
BIBLIOTECA_PELICULAS=\\<IP-DEL-NAS>\<carpeta>\peliculas
